// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^✘ (.*?) \\((.*?):(\\d+):(\\d+)\\)$",
					"message": 1,
					"file": 2,
					"line": 3,
					"column": 4
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] Build started",
					"endsPattern": "^\\[watch\\] Build finished"
				}
			},
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "typecheck",
			"type": "npm",
			"script": "typecheck",
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "never"
			},
			"group": "build"
		},
		{
			"label": "build:web",
			"type": "npm",
			"script": "build:web",
			"problemMatcher": [],
			"presentation": {
				"reveal": "never"
			}
		}
	]
}